{
  "project_name": "SynthRAD2023 Brain MRI-to-CT Synthesis",
  "experiment_name": "Model 4: Cross-Fitted ResUNet Residual Conditional Diffusion",
  "cohort": "Task 1 Brain (UMC Utrecht cohort, 60 patients)",
  "dataset": {
    "kaggle_path": "/kaggle/input/datasets/lohithkgowda/synthrad2023-brain-2d-png/synthrad_png",
    "image_size": 128,
    "intensity_range": [-1.0, 1.0],
    "exterior_background_fill": -1.0,
    "mask_source": "Strictly MRI-derived (threshold > 15, 7x7 ellipse closing, filled largest contour)",
    "num_workers": 0
  },
  "patient_splits": {
    "seed": 42,
    "isolation_policy": "Strict Patient-Level Isolation (Zero Slice Leakage)",
    "train_patients_count": 48,
    "val_patients_count": 6,
    "test_patients_count": 6,
    "train_expected_slices": 2879,
    "val_expected_slices": 372,
    "test_expected_slices": 363,
    "n_folds": 4,
    "patients_per_fold": 12
  },
  "stage1_coarse_resunet": {
    "architecture": "Supervised Residual U-Net (ResUNet)",
    "in_channels": 1,
    "out_channels": 1,
    "base_filters": 32,
    "epochs_per_fold": 40,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "loss": "Masked L1 + 0.10 * Masked SSIM",
    "output_activation": "Tanh [-1.0, 1.0]",
    "cross_fitting": "4-fold patient-level disjoint cross-fitting",
    "inference": "4-model deterministic ensemble average"
  },
  "stage2_residual_diffusion": {
    "architecture": "Residual Conditional U-Net Denoiser",
    "in_channels": 4,
    "condition_channels": ["noisy_residual_z_t", "MRI", "Coarse_CT", "MRI_derived_mask"],
    "out_channels": 1,
    "base_channels": 32,
    "time_emb_dim": 64,
    "epochs": 80,
    "batch_size": 8,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "optimizer": "AdamW",
    "lr_scheduler": "CosineAnnealingLR (eta_min=1e-6)",
    "grad_clip_max_norm": 1.0,
    "loss_function": "MSE(predicted_noise, true_noise)",
    "mixed_precision": true,
    "checkpoint_interval_epochs": 5,
    "validation_interval_epochs": 5,
    "timesteps": 1000,
    "beta_start": 0.0001,
    "beta_end": 0.02,
    "beta_schedule": "linear",
    "ddim_inference_steps": 50,
    "ddim_eta": 0.0,
    "residual_target": "z_0 = (CT - Coarse_OOF) / s",
    "ct_reconstruction": "sCT = clip(Coarse + s * z_0, -1.0, 1.0)"
  },
  "checkpoint_selection_criterion": {
    "primary_metric": "Validation Patient-Mean Composite Score",
    "equation": "score = Patient_Mean(Masked_MAE_norm) + 0.10 * (1.0 - Patient_Mean(Masked_SSIM))",
    "evaluated_split": "Frozen Validation Split (6 patients, 372 slices)"
  },
  "provisional_hu_mapping": {
    "status": "UNVERIFIED_PROVISIONAL",
    "assumed_hu_min": -1000.0,
    "assumed_hu_max": 1500.0,
    "assumed_hu_range": 2500.0,
    "bone_threshold_hu": 300.0
  }
}
